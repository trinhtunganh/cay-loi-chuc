{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "appName": {
      "type": "string",
      "metadata": {
        "description": "Tên Function App, thành địa chỉ https://<tên>.azurewebsites.net"
      }
    },
    "pin": {
      "type": "securestring",
      "metadata": {
        "description": "Mã PIN cho nhân viên (giống bên Google)"
      }
    },
    "adminPin": {
      "type": "securestring",
      "metadata": {
        "description": "Mã PIN quản trị (giống bên Google)"
      }
    },
    "packageUrl": {
      "type": "string",
      "defaultValue": "https://raw.githubusercontent.com/trinhtunganh/cay-loi-chuc/main/azure/dist/cay-azure.zip"
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "syncKey": {
      "type": "securestring",
      "metadata": {
        "description": "Khóa đồng bộ, đặt giống thuộc tính SYNC_KEY bên Google (tối thiểu 16 ký tự)"
      }
    },
    "googleUrl": {
      "type": "string",
      "metadata": {
        "description": "Địa chỉ máy chủ Google …/exec"
      }
    }
  },
  "variables": {
    "storageName": "[concat('st', take(uniqueString(resourceGroup().id, parameters('appName')), 20))]",
    "planName": "[concat(parameters('appName'), '-plan')]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[variables('storageName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "minimumTlsVersion": "TLS1_2",
        "allowBlobPublicAccess": false,
        "supportsHttpsTrafficOnly": true
      }
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "name": "[variables('planName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Y1",
        "tier": "Dynamic"
      },
      "kind": "functionapp",
      "properties": {}
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "kind": "functionapp",
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]"
      ],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "httpsOnly": true,
        "siteConfig": {
          "minTlsVersion": "1.2",
          "ftpsState": "Disabled",
          "use32BitWorkerProcess": false,
          "appSettings": [
            {
              "name": "AzureWebJobsStorage",
              "value": "[concat('DefaultEndpointsProtocol=https;AccountName=', variables('storageName'), ';AccountKey=', listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('storageName')), '2023-05-01').keys[0].value, ';EndpointSuffix=', environment().suffixes.storage)]"
            },
            {
              "name": "WEBSITE_CONTENTAZUREFILECONNECTIONSTRING",
              "value": "[concat('DefaultEndpointsProtocol=https;AccountName=', variables('storageName'), ';AccountKey=', listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('storageName')), '2023-05-01').keys[0].value, ';EndpointSuffix=', environment().suffixes.storage)]"
            },
            {
              "name": "WEBSITE_CONTENTSHARE",
              "value": "[toLower(parameters('appName'))]"
            },
            {
              "name": "FUNCTIONS_EXTENSION_VERSION",
              "value": "~4"
            },
            {
              "name": "FUNCTIONS_WORKER_RUNTIME",
              "value": "node"
            },
            {
              "name": "WEBSITE_NODE_DEFAULT_VERSION",
              "value": "~22"
            },
            {
              "name": "WEBSITE_RUN_FROM_PACKAGE",
              "value": "[parameters('packageUrl')]"
            },
            {
              "name": "PIN",
              "value": "[parameters('pin')]"
            },
            {
              "name": "ADMIN_PIN",
              "value": "[parameters('adminPin')]"
            },
            {
              "name": "AUTO_APPROVE",
              "value": "true"
            },
            {
              "name": "SYNC_KEY",
              "value": "[parameters('syncKey')]"
            },
            {
              "name": "GOOGLE_URL",
              "value": "[parameters('googleUrl')]"
            }
          ]
        }
      }
    }
  ],
  "outputs": {
    "apiUrl": {
      "type": "string",
      "value": "[concat('https://', reference(resourceId('Microsoft.Web/sites', parameters('appName'))).defaultHostName, '/api/cay')]"
    }
  }
}